# ---------- runtime ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Asal frontend yang boleh memanggil API. Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173

# ---------- auth ----------
# Wajib >= 32 karakter. Generate: openssl rand -hex 32
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
JWT_TTL_HOURS=12
# Admin pertama dibuat otomatis saat migrate kalau dua baris ini diisi.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- storage ----------
DUCKDB_PATH=./data/warehouse.duckdb
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
DUCKDB_READ_POOL=4
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=25
RETENTION_DAYS=540

# ---------- bigquery ----------
GCP_PROJECT_ID=data-
# Kosongkan kalau pakai ADC (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=
BQ_LOCATION=asia-southeast2
# Rem darurat biaya. Query yang melebihi ini ditolak BigQuery, bukan dijalankan.
BQ_MAX_BYTES_BILLED=53687091200
BQ_TIMEOUT_MS=600000

# ---------- gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Free tier punya limit ketat. Ini token bucket lokal biar tidak kena 429.
GEMINI_RPM=10
GEMINI_TIMEOUT_MS=60000

# ---------- scheduler ----------
CRON_ENABLED=true
# 04:15 WIB tiap hari
CRON_DAILY_SYNC=15 4 * * *
TZ=Asia/Jakarta
